# mcp-digger — per-machine environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# Actual environment variables always take precedence over .env values.

# Use your local clones instead of managed downloads (Mode B).
# Format: repoName:path,repoName:path
# MCP_DIGGER_LOCAL_REPOS=bsf:C:/dev/bsf-monorepo,standalone-auth:C:/dev/shared-libs/auth

# Personal Access Token for private git repos (GitLab/GitHub).
# Used according to authStrategy in .digger/config.json.
# MCP_DIGGER_PAT=glpat-xxxxxxxxxxxxxxxxxxxx

# Enable debug logging to .digger/debug.log
# MCP_DIGGER_DEBUG=1
