# mcp-digger — per-machine environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# Actual environment variables always take precedence over .env values.
#
# This file is where you put PATs referenced by `auth.PAT-EnvVarName`
# in .digger/config.json. Pick any env var name you like — the config
# points at it by name, so the secret itself never lands in the repo.

# Note: unquoted values containing ` #` (space-hash) are truncated —
# the parser treats ` #` as an inline comment delimiter.
# Wrap such values in single or double quotes to preserve them:
#   GOOD: MY_URL="https://example.com/path #section"
#   BAD:  MY_URL=https://example.com/path #section   ← truncated to "https://example.com/path"

# Personal Access Token for a private repo. The config references this
# by name via `"auth": { "PAT-EnvVarName": "MY_GITLAB_PAT" }`.
# MY_GITLAB_PAT=glpat-xxxxxxxxxxxxxxxxxxxx
